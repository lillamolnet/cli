  "paths": {
    "/api/v1/apps": {
      "get": {
        "callbacks": {},
        "deprecated": false,
        "description": "Your apps, newest first.",
        "parameters": [
          {
            "description": "Relationship paths to include in the response",
            "explode": false,
            "in": "query",
            "name": "include",
            "required": false,
            "schema": {
              "pattern": "^(latest_build|latest_deploy|latest_deploy.build)(,(latest_build|latest_deploy|latest_deploy.build))*$",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Limits the response fields to only those listed for each type",
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "additionalProperties": true,
              "example": {
                "app": "name,subdomain,description,repo_url,default_branch,auto_deploy_enabled,auto_deploy_branch,stopped_at,stopped_by,inserted_at,updated_at,url"
              },
              "properties": {
                "app": {
                  "description": "Comma separated field names for app",
                  "example": "name,subdomain,description,repo_url,default_branch,auto_deploy_enabled,auto_deploy_branch,stopped_at,stopped_by,inserted_at,updated_at,url",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "style": "deepObject"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "description": "An array of resource objects representing a app",
                      "items": {
                        "$ref": "#/components/schemas/app"
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "included": {
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/build"
                          },
                          {
                            "$ref": "#/components/schemas/deploy"
                          }
                        ]
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "jsonapi": {
                      "properties": {
                        "version": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "links": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "meta": {
                      "additionalProperties": true,
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "$ref": "#/components/responses/errors"
          }
        },
        "tags": [
          "app"
        ]
      }
    },
    "/api/v1/apps/{app_id}/builds": {
      "get": {
        "callbacks": {},
        "deprecated": false,
        "description": "An app's builds, newest first. 20 per page by default, at most 100.",
