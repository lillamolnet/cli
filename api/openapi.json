            "style": "simple"
          },
          {
            "description": "Paginates the response with the limit and offset or keyset pagination.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "example": {
                "limit": 20,
                "offset": 0
              },
              "properties": {
                "limit": {
                  "minimum": 1,
                  "type": "integer"
                },
                "offset": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "style": "deepObject"
