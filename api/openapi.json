    "/api/v1/builds/{id}/wait": {
      "get": {
        "callbacks": {},
        "deprecated": false,
        "description": "Wait for a build and its deploy to finish, for at most timeout seconds. Answers as soon as they are done. Ask again until meta.done is true.",
        "operationId": "wait_for_deploy",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Seconds to wait, 0 to 50. Defaults to 50.",
            "in": "query",
            "name": "timeout",
            "required": false,
