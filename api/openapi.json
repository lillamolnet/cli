                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "description": "An array of resource objects representing a build",
                      "items": {
                        "$ref": "#/components/schemas/build"
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "included": {
                      "items": {
                        "oneOf": []
